{
  "type": "object",
  "properties": {
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[1-9][0-9]{0,3}$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "ambiguous",
              "new"
            ]
          },
          "match": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "newName": {
            "type": "string"
          },
          "resultType": {
            "type": "string",
            "enum": [
              "",
              "weight_reps",
              "added_weight_reps",
              "reps",
              "duration",
              "distance_time",
              "free"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "match",
          "candidates",
          "newName",
          "resultType",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "title": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "single",
                          "group",
                          "circuit",
                          "interval",
                          "free"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "enum": [
                          "",
                          "superset",
                          "triset",
                          "giant_set"
                        ]
                      },
                      "title": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "ex": {
                              "type": "string",
                              "pattern": "^[en][1-9][0-9]{0,3}$"
                            },
                            "note": {
                              "type": "string"
                            },
                            "refs": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "sets": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "ex",
                            "note",
                            "refs",
                            "sets"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "label",
                      "title",
                      "note",
                      "items"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "day",
                "title",
                "blocks"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "week",
          "days"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "exercises",
    "weeks"
  ],
  "additionalProperties": false
}
