# Local development only. Copy to .env and set the passwords yourself.
# Docker Compose reads .env; export its values before running Gradle.
DB_USERNAME=sizylift
DB_PASSWORD=
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/sizylift

# Keycloak (authentication). Admin console: http://localhost:8180/admin
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
# Public Keycloak URL: it becomes the token issuer and must be reachable by the mobile app.
# For a phone on the local network use the computer's LAN address, e.g. http://192.168.1.10:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# The backend accepts only tokens whose "iss" equals this value.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/sizylift
# Where the backend downloads signing keys; may be an internal address.
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/sizylift/protocol/openid-connect/certs

# Optional social login. Applied only when the realm is first imported.
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_IDP_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
