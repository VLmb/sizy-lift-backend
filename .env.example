# Optional overrides for the local stack (compose.yaml). Copy to .env only if you need them:
# without .env everything matches application-dev.yaml.

# Public Keycloak address; it becomes the token issuer. To test on a phone, use an HTTPS tunnel
# address here and pass the same realm URL to the backend:
#   SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://<tunnel>/realms/sizylift
# KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Social login. Applied only when the realm is first imported.
# GOOGLE_IDP_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_IDP_ENABLED=true
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Consent is optional until legal documents and health-data processing are finalized.
# SIZY_CONSENT_ENABLED=true
# SIZY_CONSENT_VERSION=account-v1
# SIZY_PRIVACY_URL=https://example.com/legal/privacy/v1
# SIZY_CONSENT_URL=https://example.com/legal/account-consent/v1
