# Production settings. Copy to deploy/.env on the server, fill in, and keep it out of Git (chmod 600).
# Generate passwords with: openssl rand -base64 32

# Domains must point to the server (DNS A/AAAA records); Caddy obtains certificates for them.
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=admin@example.com

DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=

# Expo push notifications: access token with "enhanced push security" enabled
# (https://expo.dev/settings/access-tokens).
EXPO_ACCESS_TOKEN=

# DeepSeek API key for AI program import (https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=

# Grafana (telemetry), user "admin"; reachable only through an SSH tunnel.
GRAFANA_ADMIN_PASSWORD=

# Outgoing mail for e-mail verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=

# Social login. Redirect URI in the provider console:
#   https://<AUTH_DOMAIN>/realms/sizylift/broker/{google|facebook}/endpoint
GOOGLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_IDP_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Image tag for rollbacks, e.g. the Git commit.
BACKEND_VERSION=latest
