# Public entry point: HTTPS with automatic Let's Encrypt certificates for every domain.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	log {
		output stdout
		format console
	}
	# Поток событий импорта (SSE) не сжимается: сжатие копит события в буфере, и они приходят пачками.
	@compressible not path /api/v2/imports/*/events
	encode @compressible zstd gzip
	reverse_proxy backend:8080
}

{$AUTH_DOMAIN} {
	encode zstd gzip
	# The admin console is reachable only through an SSH tunnel (see docs/deployment.md).
	@admin path /admin /admin/*
	respond @admin 404
	reverse_proxy keycloak:8080
}

# Хранилище видео: только подписанные ссылки, анонимного доступа у бакета нет.
{$MEDIA_DOMAIN} {
	reverse_proxy garage:3900
}

{$WEB_DOMAIN} {
	reverse_proxy web:80
}

pwa.sizylab.ru {
	# Один прокси до API, чтобы ограничение частоты видело адрес клиента.
	handle /api/v1/feedback {
		header Cache-Control no-store
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy pwa-prototype:80
	}
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
